# Names only. Copy to .env for local work and fill in values there. Never commit real values.
# Real server files live in /etc/lf/ (see docs/specs/0001-stack-and-architecture/index.md).
# Nothing reads these yet. Each later feature starts using the ones it needs.

# local, staging or production
APP_ENV=
NODE_ENV=

# The public origin, used for the admin Origin check and absolute links
SITE_URL=

WEB_PORT=
API_PORT=

# How Next.js reaches Express over loopback
API_INTERNAL_URL=

# The app database login (lf_app_<env>)
DATABASE_URL=
# The migration login (lf_migrator_<env>). Lives only in the root only migrate env file on a server.
MIGRATE_DATABASE_URL=

SESSION_SECRET=

# Folder for uploaded images
UPLOADS_DIR=

# noop until an email provider is chosen
EMAIL_DRIVER=

# The Book a call booking page URL (owned by the Book a call feature)
CALENDLY_URL=
